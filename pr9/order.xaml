<Page x:Class="pr9.order"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pr9"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="order">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="10">
            <TextBlock Text="Ваш заказ" FontSize="22" FontWeight="Bold" Foreground="#D2691E" Margin="0,0,0,10"/>
            <Button Content="Вернуться за вафлями" Click="GoBack_Click" Margin="0,0,0,15" Width="180" HorizontalAlignment="Left" Background="#FFDAB9" BorderBrush="#D2691E"/>

            <ListBox x:Name="CartList" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <TextBlock Text="{Binding Name}" Width="200" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Price, StringFormat={}{0} руб.}" Foreground="#D2691E"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="TotalText" Text="Итого: 0 руб." FontSize="20" FontWeight="Bold" Margin="0,15,0,0" Foreground="#D2691E"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="10">
            <TextBlock Text="Куда доставить?" FontSize="22" FontWeight="Bold" Foreground="#D2691E" Margin="0,0,0,15"/>

            <TextBlock Text="ФИО:"/>
            <TextBox x:Name="NameBox" Margin="0,5,0,10" Padding="5"/>

            <TextBlock Text="Email:"/>
            <TextBox x:Name="EmailBox" Margin="0,5,0,10" Padding="5"/>

            <TextBlock Text="Адрес:"/>
            <TextBox x:Name="AddressBox" Margin="0,5,0,10" Padding="5" Height="50" AcceptsReturn="True" TextWrapping="Wrap"/>

            <TextBlock Text="Выберите соус:"/>
            <ComboBox x:Name="SauceBox" Margin="0,5,0,20">
                <ComboBoxItem Content="Кленовый сироп" IsSelected="True"/>
                <ComboBoxItem Content="Шоколадный" />
                <ComboBoxItem Content="Сгущенка" />
                <ComboBoxItem Content="Сметана и зелень" />
                <ComboBoxItem Content="Без соуса" />
            </ComboBox>

            <Button Content="Заказать" Click="Checkout_Click" Height="45" Background="#D2691E" Foreground="White" FontWeight="Bold" FontSize="16"/>
        </StackPanel>
    </Grid>
</Page>

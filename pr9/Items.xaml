<Page x:Class="pr9.Items"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pr9"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Items">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="15">
            <TextBlock Text="Вафельная" FontSize="28" FontWeight="Bold" Foreground="#D2691E" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <Button Content="Корзина" Click="GoToOrder_Click" Width="120" Height="35" Background="#FFDAB9" BorderBrush="#D2691E"/>
        </StackPanel>

        <ListBox x:Name="ProductsList" Grid.Row="1" Margin="15" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#FFDAB9" BorderThickness="2" Margin="10" Padding="10" Width="250" CornerRadius="10" Background="White">
                        <StackPanel>
  
                            <Image Source="{Binding ImagePath, StringFormat=/Images/{0}}" Height="160" Stretch="Uniform" Margin="0,0,0,10"/>

                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="Gray" TextWrapping="Wrap" Height="35" Margin="0,0,0,10"/>

                            <TextBlock Text="{Binding Price, StringFormat={}{0} руб.}" Foreground="#D2691E" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                            <Button Content="Добавить" Click="AddToCart_Click" Tag="{Binding}" Height="35" Background="#D2691E" Foreground="White" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
